# InsureAI Backend Configuration

# Database Connection (PostgreSQL default)
# When running locally without Docker or PostgreSQL service, InsureAI automatically
# falls back to local SQLite (sqlite:///./insureai.db) for zero-config testing.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insureai

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Authentication & Security
JWT_SECRET_KEY=insureai_super_secret_jwt_key_2026_dev_env_change_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440
