# InsureAI Root Environment Configuration Template

# Database Connection (PostgreSQL)
# When running with Docker Compose:
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/insureai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=insureai

# Server & Host Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# JWT Authentication & RBAC Security
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
